# ==============================================================================
# SULUT CAMPUS MONITOR — Frontend Environment Variables
# Copy this file to .env.local for local development.
# Set these on Vercel Dashboard → Project Settings → Environment Variables
# ==============================================================================

# ── Backend API Base URL ──────────────────────────────────────────────────────
# Local development (default if not set):
VITE_API_BASE_URL=http://localhost:8000/api

# Production (replace with your actual Railway backend URL):
# VITE_API_BASE_URL=https://sulut-campus-monitor-backend.up.railway.app/api
