# ==============================================================================
# SULUT CAMPUS MONITOR — Backend Environment Variables
# Copy this file to .env and fill in values before deployment.
# ==============================================================================

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_DENGAN_SECRET_KEY_ACAK_MINIMAL_32_KARAKTER

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://sulut-campus-monitor.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Cron Secret ───────────────────────────────────────────────────────────────
# Used to authenticate external cron trigger at POST /api/cron/crawl-due
CRON_SECRET=GANTI_DENGAN_CRON_SECRET_ACAK

# ── Database ──────────────────────────────────────────────────────────────────
# On Railway: mount a persistent volume at /app/data
# SQLite path will be: /app/data/database.sqlite
DATABASE_URL=sqlite:///./data/database.sqlite

# ── Vercel Environment (for cron auth bypass on local dev) ────────────────────
# Set to "production" only on actual Vercel/Railway deployment
# VERCEL_ENV=production
